    "bleelblep.ai-core": {
      "name": "AI Core",
      "description": "Shared AI plumbing for this repository's plugins. Holds one API key, one daily spending cap and one request queue, so the plugins that use a model do not each ask for their own. Does nothing on its own — install it only if a plugin asks for it.",
      "author": "bleelblep",
      "icon": "MagicWandIcon",
      "channels": {
        "latest": "1.2.5"
      },
      "versions": {
        "1.2.0": {
