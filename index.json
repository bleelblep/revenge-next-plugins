    "bleelblep.screenshot-redactor": {
      "name": "Screenshot Redactor",
      "description": "A toggle that replaces usernames and avatars with stable placeholders, so a conversation can be screenshotted without doxxing anyone. The thread still reads in order — the same person keeps the same placeholder. Also blanks emails, phone numbers, addresses, card numbers and API keys typed into the messages themselves. Everything is matched on this device; nothing is ever sent anywhere.",
      "author": "bleelblep",
      "icon": "EyeSlashIcon",
